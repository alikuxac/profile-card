{
  "name": "profile-card",
  "version": "1.5.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint",
    "preview": "wrangler pages dev out",
    "deploy": "wrangler pages deploy out",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply profile-card-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply profile-card-db --local"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^13.3.0",
    "lucide-react": "^1.46.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260916.1",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10",
    "eslint-config-next": "^16.3.5",
    "typescript": "^7",
    "wrangler": "^4.132.0"
  }
}